# TradeGuard Environment Configuration Example

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# Azure Event Hubs Configuration
EVENT_HUBS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=placeholder
EVENT_HUBS_NAME=trade-events

# Azure Service Bus Configuration
SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=placeholder
SERVICE_BUS_QUEUE_NAME=alerts-queue

# Database Configuration (Azure PostgreSQL / Local PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tradeguard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
DATABASE_URL=postgresql+psycopg2://postgres:postgres_password@localhost:5432/tradeguard

# Microservices URLs
INGESTION_SERVICE_URL=http://localhost:8001
ANOMALY_SERVICE_URL=http://localhost:8002
ALERT_CASE_SERVICE_URL=http://localhost:8003
SIMULATOR_SERVICE_URL=http://localhost:8004

# Machine Learning
MODEL_PATH=ml/models/isolation_forest_v1.joblib

# Security & Entra ID (Azure AD)
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
KEY_VAULT_URL=https://tradeguard-kv.vault.azure.net/
